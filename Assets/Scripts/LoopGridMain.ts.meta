  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">LoopGridMain – Live Loops grid controller</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float masterVolume = 0.85 {"hint":"Overall playback volume for all loops (per-row mix trims are applied on top)", "widget":"slider", "min":0, "max":1, "step":0.05}'
