    - '// @input float cellMinAimSeconds {"hint":"Extra strictness on top of the built-in travel guard: require the cell to be hovered (targeted, hand open) this many seconds before the pinch starts. 0 = gesture-state guard only, which already rejects cells a pinched hand sweeps through.", "widget":"slider", "min":0, "max":0.5, "step":0.01}'
    - '// @ui {"widget":"group_end"}'
